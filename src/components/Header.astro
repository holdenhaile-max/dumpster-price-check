---
import { href, sitePath } from "../lib/paths";

const path = sitePath(Astro.url.pathname);
const links = [
  { href: "/cities/college-station", label: "College Station" },
  { href: "/cities/bryan", label: "Bryan" },
  { href: "/guides/10-vs-15-vs-20-yard-dumpsters", label: "Sizes" },
  { href: "/guides/cheapest-7-day-dumpster-brazos-valley", label: "7-day price" },
  { href: "/guides/1-3-day-weekend-dumpster-prices", label: "1-3 day price" },
  { href: "/guides/whats-included-dumpster-rental", label: "What's included" },
  { href: "/guides/what-can-you-put-in-a-dumpster", label: "What can go in" },
  { href: "/guides/dumpster-vs-junk-removal", label: "Junk removal" },
  { href: "/about", label: "About" },
];

function current(link: string) {
  if (link === "/guides/10-vs-15-vs-20-yard-dumpsters") return path === link;
  if (link === "/guides/cheapest-7-day-dumpster-brazos-valley") return path === link;
  return path === link;
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={href("/")}>
      <img class="brand-logo" src={href("/logo.svg")} width="36" height="36" alt="" />
      <span>
        <span class="brand-name">Dumpster Price Check</span>
        <span class="brand-kicker">Dumpster rental prices, checked.</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      Menu
    </button>
    <nav id="site-menu" class="site-menu" aria-label="Primary">
      {
        links.map((link) => (
          <a href={href(link.href)} aria-current={current(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector(".nav-toggle");
  const menu = document.getElementById("site-menu");
  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open");
    button.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>
